#ifndef CONFIG_H
#define CONFIG_H

// WiFi Configuration
// Copy this file to config.h and update with your credentials
// In CI/CD environments, these can be overridden via compiler definitions
#ifndef WIFI_SSID
#define WIFI_SSID "your_wifi_ssid"
#endif

#ifndef WIFI_PASS
#define WIFI_PASS "your_wifi_password"
#endif

// Mining Pool Configuration
#ifndef POOL_URL
#define POOL_URL "solo.ckpool.org"  // Solo mining pool
// Alternative pools:
// #define POOL_URL "stratum.braiins.com"  // Braiins Pool
// #define POOL_URL "stratum.slushpool.com"  // Slush Pool
#endif

#ifndef POOL_PORT
#define POOL_PORT 3333
#endif

#ifndef WALLET_ADDRESS
#define WALLET_ADDRESS "your_bitcoin_address_here"  // Replace with your BTC address
#endif

#ifndef WORKER_NAME
#define WORKER_NAME "ESP32Miner"
#endif

#endif // CONFIG_H
